DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lead_recovery

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_REPLY_MODE=openai
TWILIO_DEMO_HVAC_NUMBER=+15550000001
TWILIO_DEMO_RENOVATION_NUMBER=+15550000002

DEMO_BUSINESS_PHONE=+15550000011

API_PORT=4000
API_BASE_URL=http://localhost:4000

API_INTERNAL_URL=http://127.0.0.1:4000
DASHBOARD_BASE_URL=http://localhost:3000
# Required in production: persistent, high-entropy secret (32+ characters).
# pnpm dev creates a private, ignored .local/auth-secret if this is omitted locally.
# Never use a NEXT_PUBLIC_ variable for auth or provider secrets.
# BETTER_AUTH_SECRET=
# Configure a verified Resend sender locally before opting in to owner emails.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=notifications@example.com
# Optional signing secret for verified document delivery/bounce status callbacks.
# RESEND_WEBHOOK_SECRET=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
WORKER_POLL_INTERVAL_MS=1000

# Development only. Production refuses to start with signature verification disabled.
TWILIO_VALIDATE_SIGNATURES=false
